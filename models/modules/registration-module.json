{
  "layers": [
    {
      "name": "Extern",
      "z": 8,
      "components": [
        {
          "id": "CLI1",
          "label": "Client\n{{channel}}",
          "type": "frontend",
          "x": -3,
          "y": 0,
          "width": 2.2,
          "height": 1.4,
          "depth": 1
        }
      ]
    },
    {
      "name": "Business",
      "z": 2,
      "components": [
        {
          "id": "SVC1",
          "label": "Registration\n{{tenant}}",
          "type": "service",
          "x": 0,
          "y": 0,
          "width": 2.4,
          "height": 1.2,
          "depth": 1
        }
      ]
    },
    {
      "name": "Data",
      "z": -4,
      "components": [
        {
          "id": "DB1",
          "label": "Registry\nDB",
          "type": "database",
          "x": 3,
          "y": -1,
          "width": 2.5,
          "height": 2,
          "depth": 2
        }
      ]
    }
  ],
  "connectionGroups": [
    {
      "name": "{{flowName}}",
      "order": 1,
      "active": true,
      "color": "#4e79a7",
      "connections": [
        {
          "id": "{{tenant}}-REG-1",
          "protocol": "{{apiProtocol}}",
          "from": "CLI1",
          "to": "SVC1",
          "order": 101,
          "label": "Create registration for {{tenant}}"
        },
        {
          "id": "{{tenant}}-REG-2",
          "protocol": "JDBC",
          "from": "SVC1",
          "to": "DB1",
          "order": 102,
          "label": "Persist registration"
        }
      ]
    }
  ],
  "typeStyles": {
    "frontend": {
      "color": "cornflowerblue"
    },
    "service": {
      "color": "lightseagreen"
    },
    "database": {
      "color": "#e15759"
    }
  },
  "settings": {
    "animateComponents": false,
    "selectConnectionsAndComponents": false,
    "showComponentPosition": false
  }
}
